      "Bash(pytest *)",
      "Bash(ruff *)",
      "Bash(mypy *)",
      "Bash(pip *)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(cd *)",
      "Bash(mkdir *)",
      "Bash(rm *)",
      "Bash(mv *)",
      "Bash(cp *)",
      "Bash(grep *)",
      "Bash(rg *)",
      "Bash(find *)",
      "Bash(echo *)",
      "Bash(date *)",
      "Bash(wc *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(sort *)",
      "Bash(uniq *)",
      "Bash(awk *)",
      "Bash(sed *)",
      "Bash(diff *)",
      "Bash(touch *)",
      "Bash(chmod *)",
      "Bash(make *)",
      "Bash(npm *)",
      "Bash(node *)",
      "Bash(docker build *)",
      "Bash(docker run --rm *)",
      "Bash(kubectl get *)",
      "Bash(kubectl describe *)",
